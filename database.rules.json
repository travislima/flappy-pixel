{
  "rules": {
    "scores": {
      ".read": true,
      ".indexOn": ["score"],
      "$scoreId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['name', 'score', 'date'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 10"
        },
        "score": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999"
        },
        "date": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "country": {
          ".validate": "newData.isString() && newData.val().length == 2"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    ".read": false,
    ".write": false
  }
}
